python
import time
from appium import webdriver
from appium.options.android import UiAutomator2Options
from appium.webdriver.common.appiumby import AppiumBy

# Create options object
options = UiAutomator2Options()
options.platform_name = "Android"
options.device_name = "emulator-5554"
options.automation_name = "UiAutomator2"
options.app_package = "com.android.settings"
options.app_activity = ".Settings"
options.uiautomator2_server_launch_timeout = 60000
options.uiautomator2_server_install_timeout = 60000
options.adb_exec_timeout = 120000   # <-- increase timeout

# Start driver
driver = webdriver.Remote("http://127.0.0.1:4723", options=options)

print("Appium server started")
time.sleep(3)

# Find element by XPath
element = driver.find_element(
    AppiumBy.XPATH,
    "//android.widget.TextView[@resource-id='android:id/title' and @text='Network & internet']"
)

print("Element attributes:")
print("Text:", element.get_attribute("text"))
print("Class:", element.get_attribute("className"))
print("Enabled:", element.get_attribute("enabled"))
print("Displayed:", element.get_attribute("displayed"))

# Click the element
element.click()
print("Network & internet tab opened")

time.sleep(3)
driver.quit()
